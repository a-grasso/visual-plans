{
  "name": "visual-plan-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, repo-agnostic Vite + MDX renderer for visual plans and recaps. No hosted service, no telemetry, nothing uploaded.",
  "scripts": {
    "serve": "node scripts/link-plans.mjs && vite",
    "dev": "node scripts/link-plans.mjs && vite",
    "build": "node scripts/link-plans.mjs && vite build",
    "preview": "vite preview",
    "check": "node scripts/link-plans.mjs && node scripts/ssr-check.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "vite": "^6.0.7"
  }
}
